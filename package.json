{
	"name": "test-skills",
	"version": "0.2.0",
	"private": true,
	"description": "Agent Skills for tests that can fail: every kind of testing, from unit and property-based to exploration, accessibility, visual, performance and LLM evals, with an audit, a weakening guard and mutation checks. Install with npx skills.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emiliodominguez/test-skills.git"
	},
	"homepage": "https://github.com/emiliodominguez/test-skills#readme",
	"bugs": {
		"url": "https://github.com/emiliodominguez/test-skills/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=22.20.0"
	},
	"packageManager": "pnpm@10.28.0",
	"scripts": {
		"skills": "node --import tsx src/index.ts",
		"validate": "node --import tsx src/index.ts validate",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.kit.json",
		"check": "pnpm run format:check && pnpm run typecheck && pnpm run validate && pnpm run test",
		"smoke": "sh scripts/smoke-install.sh",
		"verify": "pnpm run check && node scripts/verify-examples.mjs && sh scripts/verify-demo.sh && sh scripts/smoke-install.sh && node scripts/codex-check.mjs",
		"demo": "node skills/test-explore/assets/bombadil-run.mjs --start \"node examples/buggy-shop/serve.mjs --kit\" --origin http://127.0.0.1:8765/ --spec examples/buggy-shop/bombadil/spec.ts --keep-going --time-limit 2m --out out/bombadil/buggy-shop",
		"demo:fixed": "node skills/test-explore/assets/bombadil-run.mjs --start \"node examples/buggy-shop/serve.mjs --fixed --kit\" --origin http://127.0.0.1:8765/ --spec examples/buggy-shop/bombadil/spec.ts --keep-going --prune-clean --time-limit 120s --out out/bombadil/buggy-shop-fixed",
		"demo:cli": "node skills/test-explore/assets/bombadil-run.mjs --terminal \"node examples/buggy-cli/todo.mjs\" --spec examples/buggy-cli/bombadil/spec.ts --keep-going --time-limit 45s --out out/bombadil/buggy-cli -- --columns 72 --rows 28",
		"demo:cli:fixed": "node skills/test-explore/assets/bombadil-run.mjs --terminal \"TODO_FIXED=1 node examples/buggy-cli/todo.mjs\" --spec examples/buggy-cli/bombadil/spec.ts --keep-going --prune-clean --time-limit 45s --out out/bombadil/buggy-cli-fixed -- --columns 72 --rows 28",
		"demo:fc": "node examples/buggy-shop/fast-check/explore.mjs --time-limit 240",
		"demo:fc:fixed": "node examples/buggy-shop/fast-check/explore.mjs --fixed --time-limit 120",
		"codex": "node scripts/codex-check.mjs",
		"dogfood": "sh scripts/dogfood.sh"
	},
	"dependencies": {
		"js-yaml": "^5.4.3"
	},
	"devDependencies": {
		"@antithesishq/bombadil": "0.7.8",
		"@playwright/test": "1.64.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^22",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"ai": "^7.0.139",
		"axe-core": "^4.14.0",
		"fast-check": "^4.10.2",
		"jsdom": "^30.1.2",
		"msw": "^3.0.3",
		"playwright-core": "^1.64.0",
		"prettier": "^3.9.9",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^5.0.3",
		"zod": "^4.6.7"
	},
	"keywords": [
		"accessibility",
		"agent-skills",
		"ai-agents",
		"ai-generated-tests",
		"antithesis",
		"bombadil",
		"coding-agents",
		"component-testing",
		"contract-testing",
		"e2e",
		"fast-check",
		"flaky-tests",
		"fuzzing",
		"hypothesis",
		"integration-testing",
		"llm-evals",
		"load-testing",
		"mutation-testing",
		"performance-testing",
		"property-based-testing",
		"skills",
		"test-quality",
		"testing",
		"visual-regression"
	],
	"license": "MIT"
}
