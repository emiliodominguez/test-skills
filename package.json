{
	"name": "test-skills",
	"version": "0.1.0",
	"private": true,
	"description": "Portable, agent-agnostic testing skills for AI coding agents: strategy, property-based UI exploration with Bombadil, end-to-end, unit, flakiness and CI. Install with npx skills.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emiliodominguez/test-skills.git"
	},
	"homepage": "https://github.com/emiliodominguez/test-skills#readme",
	"bugs": {
		"url": "https://github.com/emiliodominguez/test-skills/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=22.20.0"
	},
	"packageManager": "pnpm@10.28.0",
	"scripts": {
		"skills": "node --import tsx src/index.ts",
		"validate": "node --import tsx src/index.ts validate",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.kit.json",
		"check": "pnpm run format:check && pnpm run typecheck && pnpm run validate && pnpm run test",
		"smoke": "sh scripts/smoke-install.sh",
		"demo": "node skills/test-bombadil/assets/bombadil-run.mjs --start \"node examples/buggy-shop/serve.mjs --kit\" --origin http://127.0.0.1:8765/ --spec examples/buggy-shop/bombadil/spec.ts --keep-going --time-limit 90s --out out/bombadil/buggy-shop",
		"demo:fixed": "node skills/test-bombadil/assets/bombadil-run.mjs --start \"node examples/buggy-shop/serve.mjs --fixed --kit\" --origin http://127.0.0.1:8765/ --spec examples/buggy-shop/bombadil/spec.ts --keep-going --time-limit 120s --out out/bombadil/buggy-shop-fixed"
	},
	"dependencies": {
		"js-yaml": "^5.4.3"
	},
	"devDependencies": {
		"@antithesishq/bombadil": "0.7.8",
		"@types/node": "^22",
		"prettier": "^3.9.9",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^5.0.3"
	},
	"keywords": [
		"agent-skills",
		"skills",
		"ai-agents",
		"coding-agents",
		"testing",
		"property-based-testing",
		"bombadil",
		"e2e",
		"flaky-tests"
	],
	"license": "MIT"
}
