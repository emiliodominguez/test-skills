{
	"name": "test-skills",
	"version": "0.2.0",
	"private": true,
	"description": "Agent Skills for tests that can fail: audit and guard agent-written tests, measure flakiness, mutation-check suites, and explore UIs with Bombadil. Install with npx skills.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emiliodominguez/test-skills.git"
	},
	"homepage": "https://github.com/emiliodominguez/test-skills#readme",
	"bugs": {
		"url": "https://github.com/emiliodominguez/test-skills/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=22.20.0"
	},
	"packageManager": "pnpm@10.28.0",
	"scripts": {
		"skills": "node --import tsx src/index.ts",
		"validate": "node --import tsx src/index.ts validate",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.kit.json",
		"check": "pnpm run format:check && pnpm run typecheck && pnpm run validate && pnpm run test",
		"smoke": "sh scripts/smoke-install.sh",
		"verify": "pnpm run check && sh scripts/verify-demo.sh && sh scripts/smoke-install.sh",
		"demo": "node skills/test-bombadil/assets/bombadil-run.mjs --start \"node examples/buggy-shop/serve.mjs --kit\" --origin http://127.0.0.1:8765/ --spec examples/buggy-shop/bombadil/spec.ts --keep-going --time-limit 2m --out out/bombadil/buggy-shop",
		"demo:fixed": "node skills/test-bombadil/assets/bombadil-run.mjs --start \"node examples/buggy-shop/serve.mjs --fixed --kit\" --origin http://127.0.0.1:8765/ --spec examples/buggy-shop/bombadil/spec.ts --keep-going --prune-clean --time-limit 120s --out out/bombadil/buggy-shop-fixed",
		"demo:cli": "node skills/test-bombadil/assets/bombadil-run.mjs --terminal \"node examples/buggy-cli/todo.mjs\" --spec examples/buggy-cli/bombadil/spec.ts --keep-going --time-limit 45s --out out/bombadil/buggy-cli -- --columns 72 --rows 28",
		"demo:cli:fixed": "node skills/test-bombadil/assets/bombadil-run.mjs --terminal \"TODO_FIXED=1 node examples/buggy-cli/todo.mjs\" --spec examples/buggy-cli/bombadil/spec.ts --keep-going --prune-clean --time-limit 45s --out out/bombadil/buggy-cli-fixed -- --columns 72 --rows 28"
	},
	"dependencies": {
		"js-yaml": "^5.4.3"
	},
	"devDependencies": {
		"@antithesishq/bombadil": "0.7.8",
		"@types/node": "^22",
		"prettier": "^3.9.9",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^5.0.3"
	},
	"keywords": [
		"agent-skills",
		"ai-agents",
		"ai-generated-tests",
		"antithesis",
		"bombadil",
		"coding-agents",
		"e2e",
		"flaky-tests",
		"fuzzing",
		"mutation-testing",
		"property-based-testing",
		"skills",
		"test-quality",
		"testing"
	],
	"license": "MIT"
}
